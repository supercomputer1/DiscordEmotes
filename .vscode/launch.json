{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET 8 Launch",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Host/bin/Debug/net8.0/Host.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Host",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    ]
}